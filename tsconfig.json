{
  "compilerOptions": {
    "target": "esnext",
    "module": "NodeNext",
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "allowJs": false,
    "checkJs": false,
    "declaration": true,
    "declarationMap": true,
    "esModuleInterop": false,
    "skipLibCheck": true,
    "declarationDir": "./types",
    "outDir": "./_internal/src",
    "rootDir": "./_internal/src",
    "resolveJsonModule": true,
    "types": [
      "@cap-js/cds-types",
      "@cap-ts/soap-adapter"
    ],
    "moduleResolution": "nodenext"
  },
  "include": [
    "_internal/src/**/*.ts",
    "_internal/types/**/*"
  ],
  "exclude": [
    "node_modules",
    "_internal/test",
    "_internal/*.*"
  ]
}